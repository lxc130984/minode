{
  "name": "minode-beta",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vp preview",
    "build-only": "vp build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "vp lint . --fix",
    "lint:eslint": "vp lint . --fix",
    "format": "vp fmt src/",
    "prepare": "vp config"
  },
  "dependencies": {
    "break_infinity.js": "^2.2.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-draggable-plus": "^0.6.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plus": "1.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
